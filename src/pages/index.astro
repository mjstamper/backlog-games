---
import Layout from '../layouts/Layout.astro';
import FeaturedBanner from '../components/FeaturedBanner.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import GameGrid from '../components/GameGrid.astro';
import { games, siteConfig, getFeaturedGame } from '../config/site';

const featured = getFeaturedGame();
---

<Layout>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-games-ink sm:text-5xl">
        {siteConfig.name}
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-games-ink-muted">
        {siteConfig.tagline}
      </p>
    </div>

    <FeaturedBanner game={featured} />

    <div class="mt-12 flex flex-col gap-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-games-ink">
          All games
        </h2>
        <CategoryFilter />
      </div>
      <GameGrid games={games} />
    </div>
  </div>
</Layout>
