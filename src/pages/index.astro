---
import Layout from '../layouts/Layout.astro';
import ArcadeHero from '../components/ArcadeHero.astro';
import FeaturedBanner from '../components/FeaturedBanner.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import GameGrid from '../components/GameGrid.astro';
import { games, getFeaturedGame } from '../config/site';

const featured = getFeaturedGame();
---

<Layout>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <ArcadeHero />

    <FeaturedBanner game={featured} />

    <div id="all-games" class="mt-12 flex flex-col gap-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-games-ink">
          All games
        </h2>
        <CategoryFilter />
      </div>
      <GameGrid games={games} />
    </div>
  </div>
</Layout>
