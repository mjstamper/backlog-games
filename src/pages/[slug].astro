---
import Layout from '../layouts/Layout.astro';
import GamePlayerShell from '../components/GamePlayerShell.astro';
import ComingSoonStage from '../components/ComingSoonStage.astro';
import { gameRegistry } from '../config/gameRegistry';
import { games, siteConfig } from '../config/site';

export function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const isPlayable = game.status === 'playable';
const PlayGame = gameRegistry[game.slug];
---

<Layout
  title={`${game.title} | ${siteConfig.name}`}
  description={game.description}
>
  <GamePlayerShell game={game}>
    {
      !isPlayable ? (<ComingSoonStage game={game} />) : 
      PlayGame ? (<PlayGame />) :
      (
        <div class="flex min-h-[420px] items-center justify-center text-games-ink-muted">
          Game loads here.
        </div>
      )
    }
  </GamePlayerShell>
</Layout>
