---
import type { Game } from '../config/site';

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
  <a
    href="/"
    class="inline-flex items-center gap-1 text-sm font-medium text-games-ink-muted transition-colors hover:text-games-accent"
  >
    <span aria-hidden="true">&larr;</span> All games
  </a>

  <div
    class="mt-4 overflow-x-hidden overflow-y-auto rounded-2xl border border-games-border bg-games-surface"
  >
    <div
      class="flex items-center justify-between gap-4 border-b border-games-border bg-games-canvas/60 px-4 py-3"
    >
      <div class="flex items-center gap-2">
        <span class="h-3 w-3 rounded-full bg-[#e85d5d]"></span>
        <span class="h-3 w-3 rounded-full bg-[#e8c15d]"></span>
        <span class="h-3 w-3 rounded-full bg-games-accent"></span>
        <span class="ml-2 text-sm font-semibold text-games-ink">{game.title}</span>
      </div>
      <button
        id="fullscreen-button"
        type="button"
        class="rounded-lg border border-games-border px-3 py-1 text-xs font-semibold text-games-ink-muted transition-colors hover:border-games-accent hover:text-games-accent"
      >
        Fullscreen
      </button>
    </div>

    <div id="game-stage" class="bg-games-canvas">
      <slot />
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-games-ink">
        {game.title}
      </h1>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-games-ink-muted">
        {game.description}
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          game.tags.map((tag) => (
            <span class="rounded-full border border-games-border px-3 py-1 text-xs text-games-ink-muted">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
    <dl class="flex gap-6 text-sm">
      <div>
        <dt class="text-games-ink-muted">Category</dt>
        <dd class="mt-1 font-semibold capitalize text-games-ink">{game.category}</dd>
      </div>
      <div>
        <dt class="text-games-ink-muted">Status</dt>
        <dd class="mt-1 font-semibold text-games-ink">
          {game.status === 'playable' ? 'Playable' : 'Coming soon'}
        </dd>
      </div>
    </dl>
  </div>
</div>

<script>
  const button = document.getElementById('fullscreen-button');
  const stage = document.getElementById('game-stage');

  button?.addEventListener('click', () => {
    if (!stage) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      stage.requestFullscreen?.();
    }
  });
</script>
