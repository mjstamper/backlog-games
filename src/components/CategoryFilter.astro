---
import { categories } from '../config/site';

const filters = [{ id: 'all', label: 'All' }, ...categories];
---

<div
  class="flex flex-wrap gap-2"
  role="group"
  aria-label="Filter games by category"
>
  {
    filters.map((filter, index) => (
      <button
        type="button"
        class="category-filter rounded-full border border-games-border px-4 py-1.5 text-sm font-medium text-games-ink-muted transition-colors hover:border-games-accent hover:text-games-ink aria-pressed:border-games-accent aria-pressed:bg-games-accent aria-pressed:text-games-canvas"
        data-category={filter.id}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        {filter.label}
      </button>
    ))
  }
</div>
