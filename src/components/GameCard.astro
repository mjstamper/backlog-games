---
import type { Game } from '../config/site';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const isPlayable = game.status === 'playable';
---

<li class="game-card" data-category={game.category}>
  <a
    href={`/${game.slug}`}
    class="group flex h-full flex-col overflow-hidden rounded-2xl border border-games-border bg-games-surface transition-colors hover:border-games-accent hover:bg-games-surface-hover"
  >
    <div class="relative aspect-[16/10] overflow-hidden bg-games-canvas">
      <img
        src={game.thumbnail}
        alt={`${game.title} thumbnail`}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
      <span
        class:list={[
          'absolute right-3 top-3 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide',
          isPlayable
            ? 'bg-games-accent text-games-canvas'
            : 'bg-games-canvas/80 text-games-ink-muted',
        ]}
      >
        {isPlayable ? 'Play' : 'Coming soon'}
      </span>
    </div>
    <div class="flex flex-1 flex-col p-4">
      <div class="flex items-center justify-between gap-2">
        <h3 class="font-semibold text-games-ink">{game.title}</h3>
        <span class="text-[10px] font-semibold uppercase tracking-wide text-games-accent">
          {game.category}
        </span>
      </div>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-games-ink-muted">
        {game.description}
      </p>
    </div>
  </a>
</li>
