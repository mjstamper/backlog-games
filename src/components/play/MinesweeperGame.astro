<div id="minesweeper-mount" class="w-full"></div>

<script>
  import { initMinesweeper } from '../../scripts/minesweeper';

  const mount = document.getElementById('minesweeper-mount');
  if (!mount) throw new Error('Minesweeper mount element not found');

  const destroy = initMinesweeper(mount);

  document.addEventListener('astro:before-swap', destroy, { once: true });
</script>
