<div id="asteroids-mount" class="w-full"></div>

<script>
  import { initAsteroids } from '../../scripts/asteroids';

  const mount = document.getElementById('asteroids-mount');
  if (!mount) throw new Error('Asteroids mount element not found');

  const destroy = initAsteroids(mount);

  document.addEventListener('astro:before-swap', destroy, { once: true });
</script>
