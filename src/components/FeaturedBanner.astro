---
import type { Game } from '../config/site';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const isPlayable = game.status === 'playable';
---

<section
  class="overflow-hidden rounded-3xl border border-games-border bg-games-surface"
  aria-labelledby="featured-heading"
>
  <div class="grid items-stretch gap-0 md:grid-cols-2">
    <div class="flex flex-col justify-center gap-4 p-6 sm:p-10">
      <span class="font-arcade text-[10px] text-games-accent">Featured</span>
      <h2
        id="featured-heading"
        class="text-3xl font-bold tracking-tight text-games-ink sm:text-4xl"
      >
        {game.title}
      </h2>
      <p class="max-w-md text-games-ink-muted">{game.description}</p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <a
          href={`/${game.slug}`}
          class="rounded-full bg-games-accent px-6 py-2.5 text-sm font-semibold text-games-canvas transition-colors hover:bg-games-accent-hover"
        >
          {isPlayable ? 'Play now' : 'View game'}
        </a>
        <span class="text-xs font-semibold uppercase tracking-wide text-games-ink-muted">
          {game.category}
        </span>
      </div>
    </div>
    <div class="relative min-h-[220px] bg-games-canvas">
      <img
        src={game.thumbnail}
        alt={`${game.title} preview`}
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>
  </div>
</section>
