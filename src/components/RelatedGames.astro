---
import type { Game } from '../config/site';
import { getRelatedGames } from '../config/relatedGames';
import GameCard from './GameCard.astro';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const related = getRelatedGames(game.slug);
---

{
  related.length > 0 && (
    <section class="mt-10 border-t border-games-border pt-8" aria-labelledby="related-games-heading">
      <h2
        id="related-games-heading"
        class="text-lg font-bold tracking-tight text-games-ink"
      >
        More like this
      </h2>
      <p class="mt-1 text-sm text-games-ink-muted">
        Same category and shared tags as {game.title}.
      </p>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {related.map((entry) => (
          <li>
            <GameCard game={entry} />
          </li>
        ))}
      </ul>
    </section>
  )
}
